<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Cipher — privacy manifest.

    libsignal ships no PrivacyInfo.xcprivacy of its own (confirmed absent from the pod and
    from the built app; see Vendor/libsignal/DECISIONS.md, Q2), so any required-reason API
    it uses has to be declared here. Enumerated 2026-07-28 against v0.99.1 and recorded in
    docs/PRIVACY_MANIFEST.md: libsignal contributes FileTimestamp (an `fstat` in the Rust
    core) and nothing else. Because it links as a *dynamic* framework its whole symbol
    surface ships whether Cipher calls it or not, so this is not conditional on our usage.

    Do not edit this file by hand without re-running Scripts/verify-privacy-manifest.sh —
    it scans every Mach-O in the built bundle and fails on a category present but not
    declared here.

    Copyright (C) 2026 Jan Richter
    SPDX-License-Identifier: AGPL-3.0-only
-->
<plist version="1.0">
<dict>
	<!-- Cipher does not track. There is no analytics SDK, no advertising identifier, and
	     no network call that leaves the user's own server. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Nothing is collected. Message content never leaves the device unencrypted and the
	     relay is designed to hold ciphertext only. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- AppSession stores onboarding, app-lock and display preferences. No secret
			     and no message content is ever written to UserDefaults; key material lives
			     in the Keychain and session state in the encrypted record store. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- CipherCrypto reads and writes file metadata inside the app container:
			     directory listings for prekey counts, and the resource value that excludes
			     the record store from backups. Container files only. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
