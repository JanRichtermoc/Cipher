            "value": "Vy"
          }
        }
      }
    },
    "You blocked this contact. Unblock them to send.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kontakt jste zablokovali. Pro odeslání jej odblokujte."
          }
        }
      }
    },
    "You can't send messages until you accept it. Accepting unblocks sending — it does not confirm the numbers match.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't send messages until you accept it. Accepting unblocks sending — it does not confirm the numbers match."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud jej nepřijmete, nemůžete odesílat zprávy. Přijetí odblokuje odesílání — nepotvrzuje, že se čísla shodují."
          }
        }
      }
    },
    "You're all caught up.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše máte přečtené."
          }
        }
      }
    },
    "Your Cipher ID": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše Cipher ID"
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše jméno"
          }
        }
      }
    },
    "Your private identity key is generated on this iPhone and stored in the iOS Keychain so it never syncs to iCloud or appears in a backup.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš soukromý identitní klíč se vytvoří v tomto iPhonu a uloží se do Klíčenky iOS, takže se nikdy nesynchronizuje na iCloud ani se neobjeví v záloze."
          }
        }
      }
    },
    "Your session is no longer valid. Redeem a new invite to sign in again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše přihlášení už není platné. Použijte novou pozvánku a přihlaste se znovu."
          }
        }
      }
    },
    "· %@": {
      "comment": "A label showing the duration of a call. The argument is the duration of the call.",
