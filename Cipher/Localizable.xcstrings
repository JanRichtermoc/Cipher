    "Cipher does not send notifications yet. None of these settings does anything.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipher zatím neposílá oznámení. Žádné z těchto nastavení nic nedělá."
          }
        }
      }
    },
    "Cipher is Locked": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipher je zamčený"
          }
        }
      }
    },
    "Cipher is invite-only for you and your friends. Enter the code someone shared with you.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipher je jen na pozvánku pro vás a přátele. Zadejte kód, který vám někdo poslal."
          }
        }
      }
    },
    "Cipher is invite-only. No email or phone number is required to join — an identifier we never collect cannot be leaked, correlated, or seized.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipher je jen na pozvání. K připojení není potřeba e-mail ani telefonní číslo — identifikátor, který nikdy nesbíráme, nemůže uniknout, být spárován ani zabaven."
          }
        }
      }
    },
    "Cipher keeps encryption and decryption on your device. This build demonstrates the complete messaging interface with Liquid Glass chrome.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipher drží šifrování a dešifrování na zařízení. Tento build ukazuje kompletní messaging UI s Liquid Glass chrome."
          }
        }
      }
    },
    "Cipher uses system Dynamic Type and Liquid Glass materials automatically.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipher automaticky používá systémový Dynamic Type a materiály Liquid Glass."
          }
        }
      }
    },
    "Cipher uses the Signal Protocol. Keys never leave your devices. The server only relays ciphertext.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipher používá Signal Protocol. Klíče neopouštějí vaše zařízení. Server jen přeposílá šifrovaná data."
          }
        }
      }
    },
