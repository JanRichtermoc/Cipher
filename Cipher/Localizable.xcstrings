    "When they arrive, the server payload will carry no message content — previews are rendered on-device, after decryption, and default to off.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až budou k dispozici, nebude přenos ze serveru obsahovat žádný obsah zprávy — náhledy se vykreslují v zařízení až po dešifrování a ve výchozím stavu jsou vypnuté."
          }
        }
      }
