    "Friends will see this name in chats. No email or phone number needed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přátelé uvidí toto jméno v chatech. E-mail ani telefon nepotřebujete."
