            "state": "translated",
            "value": "Vaše Cipher ID"
          }
        }
      }
    },
    "Your identity key is generated on your iPhone and stored in the iOS Keychain, marked so it never syncs to iCloud and never appears in a backup.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš identitní klíč se vytvoří na vašem iPhonu a uloží se do Klíčenky iOS s označením, které brání jeho synchronizaci na iCloud i jeho zahrnutí do zálohy."
          }
        }
      }
    },
    "Your invite codes": {
      "localizations": {
