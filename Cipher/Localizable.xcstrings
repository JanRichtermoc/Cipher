    },
    "Close": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavřít"
          }
        }
      }
    },
    "Compare the number with this contact to confirm no one is intercepting your messages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the number with this contact to confirm no one is intercepting your messages."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnejte číslo s tímto kontaktem a ověřte, že nikdo neodposlouchává vaše zprávy."
          }
        }
      }
    },
    "Compare these numbers with %@ in person or over a call you trust. If they match, no one is intercepting this conversation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare these numbers with %@ in person or over a call you trust. If they match, no one is intercepting this conversation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnejte tato čísla s %@ osobně nebo přes hovor, kterému důvěřujete. Pokud se shodují, nikdo tuto konverzaci neodposlouchává."
          }
        }
      }
    },
