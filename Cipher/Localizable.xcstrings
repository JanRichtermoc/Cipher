    "Start Conversation": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začít konverzaci"
          }
        }
      }
    },
    "Start a private conversation with someone you trust.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte soukromou konverzaci s někým, komu důvěřujete."
          }
        }
      }
    },
    "Starting…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začínám…"
          }
        }
      }
    },
    "That Cipher ID has no keys available, so no conversation can be started.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K tomuto Cipher ID nejsou dostupné žádné klíče, konverzaci proto nelze začít."
          }
        }
      }
    },
    "That message is too long to send.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato zpráva je příliš dlouhá na odeslání."
          }
        }
      }
    },
    "The relay cannot decrypt messages": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nemůže zprávy dešifrovat"
          }
        }
      }
    },
    "The relay is rate-limiting this device. Wait a few minutes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server omezuje počet požadavků z tohoto zařízení. Zkuste to za několik minut."
          }
        }
      }
    },
    "The relay is reachable but not working right now. Try again shortly.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je dostupný, ale právě nefunguje. Zkuste to za chvíli."
          }
        }
      }
    },
    "The relay receives public keys needed to establish encrypted sessions, but never private keys or plaintext. It deletes ciphertext after your device confirms delivery.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay přijímá veřejné klíče potřebné k navázání šifrovaných relací, ale nikdy soukromé klíče ani otevřený text. Šifrovaný text smaže, jakmile vaše zařízení potvrdí doručení."
          }
        }
      }
    },
    "The relay refused that request.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tento požadavek odmítl."
          }
        }
      }
    },
    "This contact's identity key changed. Sending is blocked, and safety-number comparison is not implemented yet — do not treat this conversation as secure.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitní klíč tohoto kontaktu se změnil. Odesílání je zablokováno a porovnání bezpečnostních čísel zatím není implementováno — tuto konverzaci nepovažujte za bezpečnou."
          }
        }
      }
    },
    "This contact's key changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This contact's key changed"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč tohoto kontaktu se změnil"
          }
        }
      }
    },
    "This contact's key changed while this screen was open, so nothing was saved. Compare the new numbers above.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This contact's key changed while this screen was open, so nothing was saved. Compare the new numbers above."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč tohoto kontaktu se změnil, když byla tato obrazovka otevřená, takže se nic neuložilo. Porovnejte nová čísla výše."
          }
        }
      }
    },
    "This conversation was deleted.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato konverzace byla smazána."
          }
        }
