    "Invite codes are not implemented yet. They have to be issued by the server so they can be single-use and expiring, and there is no server yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvací kódy zatím nejsou hotové. Musí je vydávat server, aby byly jednorázové a s omezenou platností, a server zatím neexistuje."
          }
        }
      }
    },
