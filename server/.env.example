# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Copyright (C) 2026 Jan Richter
# SPDX-License-Identifier: AGPL-3.0-only
#
# There are no default values for any secret, here or in the code. A development
# default is a production credential the day someone forgets to override it, and
# the failure is silent because the service starts fine. config.Load refuses to
# start without these; docker-compose.yml refuses to render without them.
#
# Generate each password with:
#
#     head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; echo
#
# Not a memorable phrase. These are never typed by a human, so there is no reason
# for them to be guessable by one.
#
# Two things about that command are deliberate, because the obvious alternatives
# are both wrong here:
#
#   * `head` is the PRODUCER, not the consumer. The idiom everyone reaches for —
#     `tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32` — is a SIGPIPE trap:
#     /dev/urandom never ends, so head exits first and closes the pipe under tr.
#     GNU coreutils tr then prints "write error: Broken pipe" and exits non-zero,
#     which under `set -o pipefail` fails whatever script you put it in. BSD tr
#     and BusyBox tr do not, so it works on a Mac and breaks on Linux.
#   * Hex, not base64. POSTGRES_PASSWORD is interpolated into
#     postgres://user:PASSWORD@host in docker-compose.yml, so a `/`, `+` or `=`
#     would corrupt the connection URL rather than merely look untidy.

POSTGRES_DB=cipher_relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# Published on 127.0.0.1 only. Changing this changes the host-side port, never
# the interface — see the ports: entry in docker-compose.yml.
API_PORT=8080

# debug | info | warn | error
RELAY_LOG_LEVEL=info

# Keys the rate limiter's bucket hashes. OPTIONAL, and both settings are a real
# trade-off — docs/BACKEND.md §5 argues it in full.
#
# Unset: a fresh 32-byte value per process, so every restart resets every rate-limit
# bucket. Anything that can restart the relay — a crash loop, a deploy, an OOM kill —
# hands every caller a new allowance, including on invite redemption and prekey fetch.
# The relay logs a warning at startup when this is the case.
#
# Set: buckets survive a restart, at the cost of bucket keys being stable for as long as
# the value is, so two Redis dumps taken weeks apart can be correlated. Minimum 32
# characters. Generate it like the passwords above; rotating it resets every bucket once.
#
# A deployment that is not restarted casually should set it.
RELAY_RATELIMIT_PEPPER=

# 32 bytes, base64, encrypting the APNs device token at rest (AES-256-GCM, with
# the account's aci as additional data). Leave EMPTY until push exists.
#
# Empty means the relay REFUSES to store a token, never that it stores one in the
# clear — a missing key must not become a silent downgrade. Nothing writes this
# table before P8.S02, so an empty value is correct today and is what staging runs.
#
#   openssl rand -base64 32
#
# Rotating it makes every stored token unreadable, which costs a re-registration
# and nothing else; there is no recovery path and none is wanted.
RELAY_PUSH_TOKEN_KEY=

# Peers whose X-Real-IP header may be believed: comma-separated CIDRs or bare
# addresses. Leave EMPTY unless a reverse proxy is actually in front.
#
# Empty means trust nobody — the header is ignored and the connecting peer is
# treated as the client. That is correct for local development and for the test
# suites, and it is the safe way to be wrong in production: the failure mode is
# that every caller shares one rate-limit bucket (too strict), whereas a relay
# that trusted the header would let any caller mint a fresh bucket per request
# and have no limit at all.
#
# Behind the P5 Nginx this is NOT 127.0.0.1. `ports: "127.0.0.1:8080:8080"` puts
# docker-proxy in the path, which opens a new connection into the container from
# the compose bridge GATEWAY — so a value of 127.0.0.1 trusts nothing while
# looking configured. Read the real one, and use it as a /32:
#
#     docker network inspect cipher-relay_internal \
#       --format '{{ (index .IPAM.Config 0).Gateway }}'
#
# The gateway, not the whole subnet: proxied requests only ever come from the
# gateway, and widening it to the subnet would also let the postgres and redis
# containers name any client address they liked. docs/BACKEND.md §9.2.
RELAY_TRUSTED_PROXY=
