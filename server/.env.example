# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Copyright (C) 2026 Jan Richter
# SPDX-License-Identifier: AGPL-3.0-only
#
# There are no default values for any secret, here or in the code. A development
# default is a production credential the day someone forgets to override it, and
# the failure is silent because the service starts fine. config.Load refuses to
# start without these; docker-compose.yml refuses to render without them.
#
# Generate each password with:
#
#     head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; echo
#
# Not a memorable phrase. These are never typed by a human, so there is no reason
# for them to be guessable by one.
#
# Two things about that command are deliberate, because the obvious alternatives
# are both wrong here:
#
#   * `head` is the PRODUCER, not the consumer. The idiom everyone reaches for —
#     `tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32` — is a SIGPIPE trap:
#     /dev/urandom never ends, so head exits first and closes the pipe under tr.
#     GNU coreutils tr then prints "write error: Broken pipe" and exits non-zero,
#     which under `set -o pipefail` fails whatever script you put it in. BSD tr
#     and BusyBox tr do not, so it works on a Mac and breaks on Linux.
#   * Hex, not base64. POSTGRES_PASSWORD is interpolated into
#     postgres://user:PASSWORD@host in docker-compose.yml, so a `/`, `+` or `=`
#     would corrupt the connection URL rather than merely look untidy.

POSTGRES_DB=cipher_relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# Published on 127.0.0.1 only. Changing this changes the host-side port, never
# the interface — see the ports: entry in docker-compose.yml.
API_PORT=8080

# debug | info | warn | error
RELAY_LOG_LEVEL=info
