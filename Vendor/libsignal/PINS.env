# libsignal supply-chain pins — the single source of truth.
#
# Nothing in the Podfile, CI, or any script may hard-code these values; they read
# from here so a reviewer has exactly one place to audit and one place to diff.
#
# Provenance of every value below is recorded in DECISIONS.md.
# Verified 2026-07-27.

# Release tag we depend on.
LIBSIGNAL_VERSION=0.99.1
LIBSIGNAL_TAG=v0.99.1

# The annotated tag object, and the commit it resolves to. Tags are mutable
# upstream; the commit is not.
#
# LIBSIGNAL_COMMIT is what the Podfile resolves (AUDIT 1.14), so CocoaPods never
# asks the remote what the tag points at today. LIBSIGNAL_TAG remains because the
# published release asset is addressed by it, and because the gate still checks
# the tag against this commit — as an alarm that upstream changed, not as the
# thing standing between a moved tag and code execution.
LIBSIGNAL_TAG_OBJECT_SHA=5f1fa865d15538b01654cfbd482abd95937684c6
LIBSIGNAL_COMMIT=97801d22dcf9f5bf714f7b8fa3212cdc973ae1c8

# SHA-256 of the prebuilt iOS FFI archive, taken verbatim from the official
# release asset libsignal-client-ios-build-v0.99.1.tar.gz.sha256 and independently
# re-verified against the 153 MB artifact actually served by build-artifacts.signal.org.
LIBSIGNAL_FFI_PREBUILD_CHECKSUM=c7b1ad515b0698497f051cb7a65e0d9a6e1e5d707db82aa334fa8c834e3e4fd8

# Hosts involved in the dependency. Any change here is a supply-chain review trigger.
LIBSIGNAL_GIT_URL=https://github.com/signalapp/libsignal.git
LIBSIGNAL_ARCHIVE_HOST=https://build-artifacts.signal.org/libraries

# Toolchain the pins were verified against.
VERIFIED_XCODE=26.6
VERIFIED_COCOAPODS=1.17.0
VERIFIED_XCODEPROJ_GEM=1.28.1
